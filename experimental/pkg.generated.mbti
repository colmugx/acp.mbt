// Errors
pub(all) suberror ExperimentalV2AgentAdapterError {
  EndpointMismatch(reason~ : String)
  UnexpectedMessage(kind~ : String)
  LateCompletion(request_id~ : @jsonrpc.RequestId)
  CompletionMismatch(method_name~ : String)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2AgentCompositionError {
  InvalidImplementation(reason~ : String)
  EmptyAuthMethods
  DuplicateAuthMethodId(method_id~ : String)
  AuthServiceMismatch(reason~ : String)
  DeleteServiceMismatch(reason~ : String)
  ForkServiceMismatch(reason~ : String)
  SessionMarkerMissing
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2AgentContextError {
  ContextUnavailable(method_name~ : String)
  ContextCancelled(method_name~ : String)
  ContextBrokerFailure(method_name~ : String)
  ContextReplyMismatch(method_name~ : String)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2AgentHandlerError {
  Application(message~ : String)
  InvalidParams(message~ : String)
  Cancelled
  UnavailableOperation(method_name~ : String)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2AgentMessageError {
  UnknownMethod(method_name~ : String)
  InvalidParams(method_name~ : String, cause~ : ExperimentalV2DecodeError)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2AgentProtocolError {
  NotInitialized(method_name~ : String)
  AlreadyInitialized
  AuthNotAdvertised(method_name~ : String)
  AuthMethodNotAdvertised(method_id~ : String)
  AlreadyLoggedIn
  NotLoggedIn
  CapabilityDenied(method_name~ : String, capability~ : String)
  UnknownMethod(method_name~ : String)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2AgentStateError {
  EmptyAuthMethods
  DuplicateAuthMethodId(method_id~ : String)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2BatchDecodeError {
  BatchParseFailed(message~ : String, response~ : @jsonrpc.JsonRpcResponse)
  EmptyBatch(response~ : @jsonrpc.JsonRpcResponse)
  NotABatch(value~ : Json)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2BatchEncodeError {
  EmptyBatchInput
  EmptyResponsesInput
  ItemEncodeFailed(index~ : Int, cause~ : @jsonrpc.JsonRpcCodecError)
  ResponseEncodeFailed(index~ : Int, cause~ : @jsonrpc.JsonRpcCodecError)
  ReplyFrameDecodeFailed(index~ : Int, cause~ : @jsonrpc.JsonRpcCodecError)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2ClientAdapterError {
  EndpointMismatch(reason~ : String)
  UnexpectedMessage(kind~ : String)
  LateCompletion(request_id~ : @jsonrpc.RequestId)
  CompletionMismatch(method_name~ : String)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2ClientCompositionError {
  InvalidImplementation(reason~ : String)
  MissingElicitationHandler
  ElicitationUrlRequiresComplete(reason~ : String)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2ClientConnectionError {
  UnsupportedVersion(method_name~ : String, offered~ : Int)
  Unavailable(method_name~ : String)
  Cancelled(method_name~ : String)
  BrokerFailure(method_name~ : String)
  ReplyMismatch(method_name~ : String)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2ClientHandlerError {
  Application(message~ : String)
  InvalidParams(message~ : String)
  Cancelled
  UnavailableOperation(method_name~ : String)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2ClientMessageError {
  UnknownMethod(method_name~ : String)
  InvalidParams(method_name~ : String, cause~ : ExperimentalV2DecodeError)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2ClientProtocolError {
  NotReady(method_name~ : String)
  AlreadyReady
  UnsupportedVersion(offered~ : Int)
  CapabilityDenied(method_name~ : String, capability~ : String)
  UnknownMethod(method_name~ : String)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2DecodeError {
  JsonParse(message~ : String)
  ExpectedObject(path~ : String)
  ExpectedArray(path~ : String)
  ExpectedString(path~ : String)
  ExpectedBoolean(path~ : String)
  ExpectedNumber(path~ : String)
  MissingField(path~ : String)
  UnknownField(path~ : String)
  InvalidField(path~ : String, reason~ : String)
  InvalidDiscriminator(path~ : String, value~ : String)
  InvalidPath(path~ : String, value~ : String)
  InvalidBase64(path~ : String)
} derive(Eq, @debug.Debug)

pub(all) suberror ExperimentalV2SessionFoldError {
  ChunkForUnknownToolCall(tool_call_id~ : String)
  IllegalStateTransition(from~ : ExperimentalV2TurnPhase, to~ : ExperimentalV2TurnPhase)
  PlanVariantMissingPlanId
} derive(Eq, @debug.Debug)

